{
    "name": "tourbnt",
    "version": "1.0.0",
    "description": "TourBNT - Tour booking and management platform",
    "private": true,
    "workspaces": [
        "frontend",
        "server",
        "packages/db"
    ],
    "scripts": {
        "build:server": "npm run build --prefix server",
        "build:frontend": "npm run build --prefix frontend",
        "build": "npm run build:server && npm run build:frontend",
        "start:server": "npm start --prefix server",
        "start:frontend": "npm start --prefix frontend",
        "start": "npm run start:server",
        "dev:server": "npm run dev --prefix server",
        "dev:frontend": "npm run dev --prefix frontend",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
        "dev:server:lan": "FRONTEND_DOMAIN=\"http://$(ipconfig getifaddr en0):3000,http://localhost:3000,http://localhost:8000\" npm run dev --prefix server",
        "dev:frontend:lan": "NEXT_PUBLIC_BACKEND_URL=\"http://$(ipconfig getifaddr en0):8000\" npm run dev --prefix frontend -- -H 0.0.0.0",
        "dev:lan": "concurrently \"npm run dev:server:lan\" \"npm run dev:frontend:lan\"",
        "db:generate": "npm run db:generate --workspace=@tourbnt/db",
        "db:migrate": "npm run db:migrate --workspace=@tourbnt/db",
        "db:push": "npm run db:push --workspace=@tourbnt/db",
        "db:studio": "npm run db:studio --workspace=@tourbnt/db"
    },
    "engines": {
        "node": ">=22.22.0",
        "npm": ">=9.0.0"
    },
    "keywords": [
        "tour",
        "booking",
        "travel",
        "nextjs",
        "express",
        "postgres",
        "drizzle"
    ],
    "author": "TourBNT Team",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^8.2.2",
        "drizzle-orm": "^0.45.3"
    },
    "dependencies": {
        "@neon/config": "^1.8.2",
        "@neon/env": "^1.4.7"
    }
}
