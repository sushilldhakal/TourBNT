PORT=
NODE_ENV=

# Postgres - single source of truth (see server/src/db). Provided later.
DATABASE_URL=postgres://username:password@host:5432/tourbnt
# Row-level security for signed-in booking, payout and ad routes (see src/middlewares/rowLevelSecurity.ts).
# Needs migration 0021. Off unless "on".
DB_RLS=off

# Redis - cache in front of Postgres (see src/config/redisClient.ts). Optional:
# defaults to a local instance, so dev works without setting this.
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=

# Cloudflare R2 (S3-compatible object storage) - single bucket for all media.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=

FRONTEND_DOMAIN=

# Sign-in options (each is off until its settings are present)
# Google: Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=
# Facebook: developers.facebook.com > your app > App settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Passkeys (fingerprint / face): the site's domain. Defaults to the host of the first FRONTEND_DOMAIN.
WEBAUTHN_RP_ID=tourbnt.com

# --- AI writing assistant (Novel editor) ---------------------------------------
# Providers are tried in AI_PROVIDER_ORDER; any without credentials is skipped.
# Keys are server-side only — never expose them via NEXT_PUBLIC_*.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
CLOUDFLARE_AI_API_TOKEN=
# Defaults to CLOUDFLARE_R2_ACCOUNT_ID
# CLOUDFLARE_AI_ACCOUNT_ID=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_PROVIDER_ORDER=gemini,cloudflare,openrouter
# AI_USER_DAILY_LIMIT=30
# AI_USER_PER_MINUTE_LIMIT=6
# AI_GLOBAL_DAILY_LIMIT=0
