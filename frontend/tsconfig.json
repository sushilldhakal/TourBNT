{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/types/*": ["./types/*"],
      "@/app/*": ["./app/*"],
      "@/providers/*": ["./providers/*"],
      "@/public/*": ["./public/*"],
      "@/hooks": ["./lib/hooks"],
      "@/hooks/*": ["./lib/hooks/*"],
      "@/queries": ["./lib/queries"],
      "@/queries/*": ["./lib/queries/*"],
      "@/config": ["./lib/config"],
      "@/config/*": ["./lib/config/*"],
      "@/store": ["./lib/store"],
      "@/store/*": ["./lib/store/*"],
      "@/api": ["./lib/api"],
      "@/api/*": ["./lib/api/*"],
      "@/utils": ["./lib/utils/index"],
      "@/utils/*": ["./lib/utils/*"],
      "@/middleware": ["./lib/middleware"],
      "@/middleware/*": ["./lib/middleware/*"],
      "@/schemas": ["./lib/schemas"],
      "@/schemas/*": ["./lib/schemas/*"],
      "@/ui": ["./components/ui"],
      "@/ui/*": ["./components/ui/*"],
      "@/dashboard": ["./components/dashboard"],
      "@/dashboard/*": ["./components/dashboard/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}