# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# Markdown / internal docs
*.md
!README.md
docs/
lib/**/README.md

# Secrets & credentials
secrets.json
credentials.json
**/secrets*.json
**/*credentials*.json
*.local
config.local.*

# vercel
.vercel
.next/
.agents
.cursor
.kiro
.windsurf

# typescript
*.tsbuildinfo
next-env.d.ts
