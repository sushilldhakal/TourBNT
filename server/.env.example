PORT=
NODE_ENV=

# Postgres - single source of truth (see server/src/db). Provided later.
DATABASE_URL=postgres://username:password@host:5432/tourbnt

# Redis - cache in front of Postgres (see src/config/redisClient.ts). Optional:
# defaults to a local instance, so dev works without setting this.
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=

# Cloudflare R2 (S3-compatible object storage) - single bucket for all media.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=

FRONTEND_DOMAIN=
